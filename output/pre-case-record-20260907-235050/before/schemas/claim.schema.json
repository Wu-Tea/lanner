{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-cognition.local/schemas/claim.schema.json",
  "title": "Project Cognition Transitional Claim (Historical)",
  "description": "Historical 0.1.0 validation asset from the pre-reset design. It is not the current MVP Task Frame, Result Envelope, Knowledge Delta, or Base schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "topic",
    "kind",
    "status",
    "scope",
    "value",
    "authority",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "derived_fact",
        "declared_intent",
        "observed_evidence",
        "ephemeral_context"
      ]
    },
    "status": {
      "enum": [
        "observed",
        "inferred",
        "proposed",
        "human-confirmed",
        "superseded"
      ]
    },
    "scope": {
      "type": "object",
      "description": "Dimensions that determine where the claim applies.",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": ["string", "number", "boolean"]
      }
    },
    "value": true,
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "depends_on_claims": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._:-]*$"
      }
    },
    "impacted_by": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/impactLocator"
      }
    },
    "verification": {
      "$ref": "#/$defs/verification"
    },
    "confirmation": {
      "$ref": "#/$defs/confirmation"
    },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._:-]*$"
      }
    },
    "superseded_by": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._:-]*$"
      }
    },
    "renders_to": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "observed"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["verification"]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "inferred"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["confidence"]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "human-confirmed"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["confirmation"]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "superseded"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["superseded_by"]
      }
    }
  ],
  "$defs": {
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "code-default",
            "recommended-config",
            "runtime-observation",
            "accepted-decision",
            "architecture-contract",
            "test-evidence",
            "documentation",
            "session-context",
            "unknown"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "policy_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      },
      "oneOf": [
        {
          "required": ["path"]
        },
        {
          "required": ["uri"]
        }
      ]
    },
    "impactLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "enum": [
            "path",
            "symbol",
            "config-key",
            "build-target",
            "claim"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "verified_at"],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "verified_commit": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed_by", "confirmed_at", "basis"],
      "properties": {
        "confirmed_by": {
          "type": "string",
          "minLength": 1
        },
        "confirmed_at": {
          "type": "string",
          "format": "date-time"
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
